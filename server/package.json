{
  "name": "draft-class-generator-server",
  "version": "1.5.2",
  "private": true,
  "description": "Local Node/Express backend for the Madden 26 NFL Draft Class Generator",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node scripts/copy-assets.js",
    "start": "node dist/server.js",
    "smoke:mdc": "node scripts/smoke-mdc.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "data:refresh": "tsx scripts/refresh-data.ts",
    "data:depth": "tsx scripts/build-depth-slots.ts",
    "data:gear": "tsx scripts/import-gear-sprites.ts",
    "verify": "node scripts/verify-export.js 2003 && node scripts/verify-export.js 1965 && node scripts/verify-m27.js",
    "verify:franchise": "tsx scripts/verify-franchise.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "bit-buffer": "^0.2.5",
    "cors": "^2.8.5",
    "crc-32": "^1.2.2",
    "draft-class-generator": "file:..",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "fzstd": "^0.1.1",
    "madden-franchise": "^4.3.6",
    "papaparse": "^5.5.3",
    "sharp": "^0.34.4",
    "stream-parser": "^0.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/papaparse": "^5.3.15",
    "fflate": "^0.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "sharp@0.34.5": true
  }
}
